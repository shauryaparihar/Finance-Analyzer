# Backend configuration (copy to .env and adjust; never commit the real .env)
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://finsight:finsight@localhost:5432/finsight
FRONTEND_URL=http://localhost:5173
# Other exact https origins allowed to use the cookie endpoints (custom domain, preview URL), comma-separated. No wildcards.
EXTRA_FRONTEND_ORIGINS=

# Required in production: a long random value, e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`.
# Leave empty in development (a built-in insecure development secret is used, and rejected in production).
JWT_SECRET=

# One-click read-only guest login (POST /api/auth/demo). Off by default.
DEMO_ENABLED=false

# Login sessions (all optional)
ACCESS_TOKEN_EXPIRE_MINUTES=15   # short-lived access token, held in memory by the website
REFRESH_TOKEN_DAYS=7             # refresh cookie lifetime; it rotates on every use
REFRESH_FAMILY_MAX_DAYS=30       # a login session can never be extended past this
# COOKIE_SECURE=                 # empty: Secure cookies in production, plain cookies in local development

# Analysis jobs and logging (all optional)
ANALYSIS_WORKERS=2          # analyses that may run at once in this process
MAX_ACTIVE_JOBS=10          # queued + running analyses (all users) before new uploads get 503 SERVER_BUSY
JOB_POLL_SECONDS=1          # how often an idle worker looks for queued work in the database
JOB_HEARTBEAT_SECONDS=10    # a running job proves it is alive this often
JOB_STALE_AFTER_SECONDS=60  # no heartbeat for this long = the worker died; the job is re-queued
JOB_MAX_ATTEMPTS=2          # an interrupted job is retried until it has been tried this many times
LOG_LEVEL=INFO
# LOG_EXCEPTION_MESSAGES=false  # keep false: exception messages can echo user data. true only for local debugging.

# Tests use a separate database. The name must end with "_test" (tests refuse to run otherwise).
TEST_DATABASE_URL=postgresql+psycopg://finsight:finsight@localhost:5432/finsight_test

# Frontend configuration (used in the Vite build)
VITE_API_URL=http://localhost:8000
