{
  "info": {
    "name": "FinSight API check",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run top to bottom against local or deployed API. Set base_url (for example https://finance-analyzer-nu.vercel.app or http://localhost:8000). Use a throwaway email."
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000"
    },
    {
      "key": "email",
      "value": "postman-check@example.com"
    },
    {
      "key": "password",
      "value": "postman-check-pass-1"
    },
    {
      "key": "access_token",
      "value": ""
    },
    {
      "key": "upload_id",
      "value": ""
    },
    {
      "key": "transaction_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/healthz",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "healthz"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('healthy', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Readiness (database + model)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/readyz",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "readyz"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('ready', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Register",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/auth/register",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "auth",
            "register"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"email\": \"{{email}}\", \"password\": \"{{password}}\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('created', () => pm.expect([201,409]).to.include(pm.response.code));"
            ]
          }
        }
      ]
    },
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/auth/login",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "auth",
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"email\": \"{{email}}\", \"password\": \"{{password}}\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('logged in', () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set('access_token', pm.response.json().access_token);"
            ]
          }
        }
      ]
    },
    {
      "name": "Me",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/auth/me",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "auth",
            "me"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('role is user', () => pm.expect(pm.response.json().role).to.eql('user'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Upload CSV (choose data/sample_descriptions_only.csv)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/uploads",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "uploads"
          ]
        },
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "file",
              "type": "file",
              "src": ""
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('accepted', () => pm.expect([200,202]).to.include(pm.response.code));",
              "pm.collectionVariables.set('upload_id', pm.response.json().upload_id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Status (repeat until completed)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/uploads/{{upload_id}}/status",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "uploads",
            "{{upload_id}}",
            "status"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('has a status', () => pm.expect(pm.response.json().status).to.be.a('string'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Summary",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/uploads/{{upload_id}}/summary",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "uploads",
            "{{upload_id}}",
            "summary"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('ok', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Forecast",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/uploads/{{upload_id}}/forecast",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "uploads",
            "{{upload_id}}",
            "forecast"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('ok', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Unusual transactions",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/uploads/{{upload_id}}/anomalies",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "uploads",
            "{{upload_id}}",
            "anomalies"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('ok', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Transactions",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/uploads/{{upload_id}}/transactions?limit=5",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "uploads",
            "{{upload_id}}",
            "transactions?limit=5"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('ok', () => pm.response.to.have.status(200));",
              "const t = pm.response.json().transactions[0]; if (t) pm.collectionVariables.set('transaction_id', t.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Correct a category",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/transactions/{{transaction_id}}/category",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "transactions",
            "{{transaction_id}}",
            "category"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"category\": \"Groceries\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('updated', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Budget risk",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/uploads/{{upload_id}}/budget-risk",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "uploads",
            "{{upload_id}}",
            "budget-risk"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('ok', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Without a token (must be refused)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/uploads",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "uploads"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('401', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "Delete the analysis",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/uploads/{{upload_id}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "uploads",
            "{{upload_id}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('deleted', () => pm.response.to.have.status(204));"
            ]
          }
        }
      ]
    },
    {
      "name": "Log out",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-FinSight-Request",
            "value": "1"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/auth/logout",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "auth",
            "logout"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('logged out', () => pm.response.to.have.status(204));"
            ]
          }
        }
      ]
    }
  ]
}